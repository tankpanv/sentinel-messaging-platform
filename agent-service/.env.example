# agent-service 本地配置
# 复制为 .env 后填写。已存在于进程环境中的同名变量不会被覆盖。
# 与 scripts/dev-local.sh 一起用时：根目录 .env 会先 export AGENT_PROVIDER=mock，
# 因此要启用真实模型请把 AGENT_PROVIDER 和密钥写在仓库根目录 .env。

PORT=28082
AGENT_PROVIDER=mock
# AGENT_SESSION_FILE=./data/sessions.json

# --- 仅当 AGENT_PROVIDER=anthropic ---
# 官方 Anthropic：
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=512
# AGENT_MODEL_TIMEOUT_MS=14000

# OpenRouter / 其它兼容网关：用 Bearer，并显式清空官方 key，避免回退到 x-api-key
# AGENT_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_MODEL=
# ANTHROPIC_API_KEY=

# 故障测试（测试脚本使用，日常开发不要开）
# ENABLE_FAULT_INJECTION=true
# AGENT_TURN_DELAY_MS=0
