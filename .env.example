# Local development — 与 scripts/dev-local.sh 默认端口对齐
BACKEND_PORT=28080
PORT=28080
GATEWAY_PORT=28081
AGENT_PORT=28082
FRONTEND_PORT=25173
DATABASE_URL=postgresql://sentinel:sentinel@127.0.0.1:5432/sentinel
GATEWAY_URL=http://127.0.0.1:28081
AGENT_URL=http://127.0.0.1:28082
VITE_BACKEND_URL=http://127.0.0.1:28080
JWT_SECRET=local-development-secret
CORS_ORIGINS=http://127.0.0.1:25173,http://localhost:25173
MEDIA_DIR=./media
MEDIA_RETENTION_DAYS=30
MEDIA_MAX_BYTES=10485760
MEDIA_DOWNLOAD_MAX_ATTEMPTS=5
GATEWAY_MEDIA_DIR=./media_gateway
GATEWAY_MEDIA_RETENTION_DAYS=30
GATEWAY_MEDIA_MAX_BYTES=10485760
# GATEWAY_PUBLIC_URL=http://127.0.0.1:28081
ENABLE_GATEWAY_SIMULATION=true
AGENT_PROVIDER=mock

# Optional tracing receiver; leave empty for local console-only work
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# PostgreSQL used by scripts/setup-local-db.sh
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
APP_DB_NAME=sentinel
APP_DB_USER=sentinel
APP_DB_PASSWORD=sentinel

# One-click local PostgreSQL container
POSTGRES_CONTAINER_NAME=sentinel-postgres-local
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_DB=sentinel
POSTGRES_APP_USER=sentinel
POSTGRES_APP_PASSWORD=sentinel
POSTGRES_VOLUME=sentinel-postgres-data
